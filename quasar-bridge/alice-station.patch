diff --git a/internal/bridge/fail_to_alice_test.go b/internal/bridge/fail_to_alice_test.go
new file mode 100644
index 0000000..02b8d77
--- /dev/null
+++ b/internal/bridge/fail_to_alice_test.go
@@ -0,0 +1,36 @@
+package bridge
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/coder/websocket"
+)
+
+// alice-station: a failed model answer (e.g. HTTP 429) goes to Alice instead of an error phrase.
+func TestNativeLLMFailureGoesToAlice(t *testing.T) {
+	n, up, down := soundSession(t, resolverFunc(func(context.Context, string) (Resolution, error) {
+		return Resolution{Route: "llm"}, errors.New("LLM returned HTTP 429")
+	}))
+	n.LLMFailToAlice = true
+	if err := n.Client(t.Context(), websocket.MessageBinary, soundInput("busy")); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case f := <-up:
+		if f.Client.GetEvent().GetTextInput() == nil || f.Client.GetEvent().GetHeader().GetMessageId() != "busy" {
+			t.Fatalf("unexpected upstream frame: %v", f.Kind())
+		}
+	case f := <-down:
+		t.Fatalf("local reply instead of Alice: %v", f.Kind())
+	case <-time.After(2 * time.Second):
+		t.Fatal("request was not handed to Alice")
+	}
+	select {
+	case f := <-down:
+		t.Fatalf("unexpected local reply: %v", f.Kind())
+	case <-time.After(200 * time.Millisecond):
+	}
+}
