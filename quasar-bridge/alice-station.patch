@@ -0,0 +1,44 @@
+package bridge
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestMemoryCommands(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("QUASAR_MEMORY_FILE", filepath.Join(dir, "memory.txt"))
+	t.Setenv("QUASAR_PERSONA_FILE", filepath.Join(dir, "persona.txt"))
+	os.WriteFile(filepath.Join(dir, "persona.txt"), []byte("Ты тёплая и любопытная."), 0o600)
+	if a, ok := memoryCommand("Алиса, запомни, что меня зовут Саша"); !ok || a != "Запомнила: меня зовут саша." {
+		t.Fatalf("%q %v", a, ok)
+	}
+	if _, ok := memoryCommand("почему небо голубое"); ok {
+		t.Fatal("plain question treated as memory command")
+	}
+	sys := personaSystem()
+	if !strings.Contains(sys, "меня зовут саша") || !strings.Contains(sys, "тёплая") {
+		t.Fatalf("system: %q", sys)
+	}
+	if a, ok := memoryCommand("забудь всё"); !ok || a == "" {
+		t.Fatal("forget")
+	}
+	if strings.Contains(personaSystem(), "саша") {
+		t.Fatal("memory not cleared")
+	}
+}
+
+func TestWriteRouteFile(t *testing.T) {
+	f := filepath.Join(t.TempDir(), "route")
+	t.Setenv("QUASAR_ROUTE_FILE", f)
+	writeRouteFile("llm")
+	if b, _ := os.ReadFile(f); string(b) != "assistant\n" {
+		t.Fatalf("%q", b)
+	}
+	writeRouteFile("yandex")
+	if b, _ := os.ReadFile(f); string(b) != "alice\n" {
+		t.Fatalf("%q", b)
+	}
+}
