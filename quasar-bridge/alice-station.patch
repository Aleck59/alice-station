+
+// voiceInfo travels with one speaker request in its context.
+type voiceInfo struct {
+	mu      sync.Mutex
+	id      string
+	created time.Time
+	tap     micTap
+	speaker string // stable anonymous voice id from Yandex biometry, "" if unknown
+	emotion string // joy, sad, angry, wow, love, neutral — chosen by the model
+	whisper int    // 0 undecided, 1 whisper, 2 normal
+}
+
+type voiceKey struct{}
+
+func withVoice(ctx context.Context, v *voiceInfo) context.Context {
+	return context.WithValue(ctx, voiceKey{}, v)
+}
+func voiceFrom(ctx context.Context) *voiceInfo {
+	v, _ := ctx.Value(voiceKey{}).(*voiceInfo)
+	return v
+}
+
+func envFloat(name string, def float64) float64 {
+	if v, err := strconv.ParseFloat(strings.TrimSpace(os.Getenv(name)), 64); err == nil {
+		return v
+	}
+	return def
+}
+func envOn(name string, def bool) bool {
+	switch strings.ToLower(strings.TrimSpace(os.Getenv(name))) {
+	case "1", "true", "yes", "on":
+		return true
+	case "0", "false", "no", "off":
+		return false
+	}
+	return def
+}
+
+// newVoiceInfo reads what aliced tells about the speaker. Yandex voice
+// biometry (people added in «Дом с Алисой» → «Голос») arrives as
+// GuestUserOptions with origin VoiceBiometry and status Match.
+func newVoiceInfo(id string, req *request.TAliceRequestProto) *voiceInfo {
+	v := &voiceInfo{id: requestTag(id), created: time.Now()}
+	add := req.GetRequest().GetAdditionalOptions()
+	g := add.GetGuestUserOptions()
+	enrolled := []string{}
+	for _, h := range req.GetEnrollmentHeaders().GetHeaders() {
+		enrolled = append(enrolled, h.GetUserType().String())
+	}
+	if g != nil && g.GetStatus().String() == "Match" && g.GetPersId() != "" {
+		v.speaker = "pers:" + shortHash(g.GetPersId())
+	}
+	bio := req.GetRequest().GetBiometryOptions()
+	slog.Info("native_voice_identity", "request", requestTag(id), "format", req.GetFormat(),
+		"guest", g != nil, "guest_origin", g.GetGuestOrigin().String(), "guest_status", g.GetStatus().String(),
+		"guest_confidence", g.GetMatchConfidence().String(), "owner_enrolled", g.GetIsOwnerEnrolled(),
+		"speaker", v.speaker, "enrolled", strings.Join(enrolled, ","), "users", len(add.GetUsersOptions()),
+		"speakers_count", add.GetSpeakersCount(), "bio_scoring", bio.GetScoring().GetEnabled(),
+		"bio_classification", bio.GetClassification().GetEnabled(), "asr_biometry", req.GetAdvancedAsrOptions().GetBiometry() != "")
+	return v
+}
+
+func shortHash(s string) string {
+	sum := sha256.Sum256([]byte(s))
+	return fmt.Sprintf("%x", sum[:6])
+}
+
+func (v *voiceInfo) feed(b []byte) {
+	v.mu.Lock()
+	v.tap.feed(b)
+	v.mu.Unlock()
+}
+
+// isWhisper decides once per request from the audio seen so far.
+func (v *voiceInfo) isWhisper(string) bool {
+	if v == nil {
+		return false
+	}
+	if nightMode(time.Now()) {
+		return true
+	}
+	if !envOn("QUASAR_WHISPER", true) {
+		return false
+	}
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if v.whisper != 0 {
+		return v.whisper == 1
+	}
+	s := v.tap.stats
+	min := int(envFloat("QUASAR_WHISPER_MIN_FRAMES", 12))
+	v.whisper = 2
+	celtFrames := s.CELTPitched + s.CELTFlat
+	celtGain := 0.0
+	if celtFrames > 0 {
+		celtGain = float64(s.CELTGainSum) / float64(celtFrames)
+	}
+	if s.Active() >= min {
+		if s.VoicedRatio() <= envFloat("QUASAR_WHISPER_VOICED_MAX", 0.2) {
+			v.whisper = 1
+		}
+	} else if tilt, n := s.CELTTilt(); n >= min && tilt <= envFloat("QUASAR_WHISPER_CELT_TILT_MAX", 1.5) {
+		// CELT (the Station mic): low (0-600 Hz) minus mid (1.6-4 kHz) band
+		// energy of the loudest frames, log2 units (1 = 6 dB). Voiced speech
+		// has strong harmonics low, whisper is breath noise without them.
+		v.whisper = 1
+	}
+	tilt, tiltFrames := s.CELTTilt()
+	slog.Info("native_whisper", "request", v.id, "whisper", v.whisper == 1, "packets", s.Packets, "celt", s.CELT,
+		"skipped", s.Skipped, "inactive", s.Inactive, "voiced", s.Voiced, "unvoiced", s.Unvoiced,
+		"voiced_ratio", fmt.Sprintf("%.2f", s.VoicedRatio()), "gain", fmt.Sprintf("%.1f", s.MeanGain()),
+		"celt_silent", s.CELTSilent, "celt_pitched", s.CELTPitched, "celt_flat", s.CELTFlat,
+		"celt_pitched_ratio", fmt.Sprintf("%.2f", s.PitchedRatio()), "celt_pitch_gain", fmt.Sprintf("%.2f", celtGain),
+		"celt_tilt", fmt.Sprintf("%.2f", tilt), "celt_tilt_frames", tiltFrames)
+	return v.whisper == 1
+}
+
+func (v *voiceInfo) setEmotion(e string) {
+	if v == nil {
+		return
+	}
+	v.mu.Lock()
+	v.emotion = e
+	v.mu.Unlock()
+}
+func (v *voiceInfo) getEmotion() string {
+	if v == nil {
+		return ""
+	}
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return v.emotion
+}
+func (v *voiceInfo) whisperDecided() bool {
+	if v == nil {
+		return false
+	}
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return v.whisper == 1
+}
+
+// ---- speaker names ----
+
+var voicesMu sync.Mutex
+
+func voicesPath() string {
+	return envPath("QUASAR_VOICES_FILE", "/data/opt/quasar-bridge/voices.json")
+}
+func loadVoices() map[string]string {
+	m := map[string]string{}
+	if b, err := os.ReadFile(voicesPath()); err == nil {
+		_ = json.Unmarshal(b, &m)
+	}
+	return m
+}
+func (v *voiceInfo) speakerID() string {
+	if v == nil {
+		return ""
+	}
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return v.speaker
+}
+
+func speakerName(id string) string {
+	if id == "" {
+		return ""
+	}
+	voicesMu.Lock()
+	defer voicesMu.Unlock()
+	return loadVoices()[id]
+}
+
+var nameRe = regexp.MustCompile(`^(?:алиса[,\s]+)?(?:запомни(?: мой голос)?[,\s]+)?(?:меня зовут|моё имя|мое имя|зови меня|называй меня)\s+([а-яёa-z][а-яёa-z-]{1,20})[.!\s]*$`)
+
+// nameCommand binds «меня зовут …» to the recognized voice.
+func nameCommand(ctx context.Context, text string) (string, bool) {
+	m := nameRe.FindStringSubmatch(strings.TrimSpace(strings.ToLower(text)))
+	if m == nil {
+		return "", false
+	}
+	name := []rune(m[1])
+	name[0] = []rune(strings.ToUpper(string(name[0])))[0]
+	v := voiceFrom(ctx)
+	if v == nil || v.speakerID() == "" {
+		return "Приятно познакомиться, " + string(name) + "! Только по голосу я пока людей не различаю: добавьте свой голос в приложении «Дом с Алисой», и тогда я буду вас узнавать.", true
+	}
+	voicesMu.Lock()
+	defer voicesMu.Unlock()
+	all := loadVoices()
+	all[v.speakerID()] = string(name)
+	b, _ := json.MarshalIndent(all, "", "  ")
+	if err := os.WriteFile(voicesPath(), b, 0o600); err != nil {
+		return "Не получилось запомнить имя.", true
+	}
+	return "Приятно познакомиться, " + string(name) + "! Теперь буду узнавать вас по голосу.", true
+}
+
+// styleSystem is appended to the system prompt for this request.
+func styleSystem(ctx context.Context, id string) string {
+	var b strings.Builder
+	v := voiceFrom(ctx)
+	if v != nil {
+		if name := speakerName(v.speakerID()); name != "" {
+			b.WriteString("\n\nСейчас говорит " + name + " (узнан(а) по голосу). Можно иногда, к месту, обращаться по имени, но не в каждой реплике.")
+		}
+		if v.isWhisper(id) {
+			b.WriteString("\n\nСобеседник говорит шёпотом — вероятно, рядом кто-то спит. Отвечай коротко, одним-двумя предложениями, мягко и спокойно, без восклицаний и встречных вопросов. Это правило важнее указаний о длине ответа.")
+		}
+	}
+	b.WriteString("\n\nВ самом начале ответа поставь одну метку настроения ответа: [радость], [грусть], [удивление], [злость], [нежность] или [спокойно]. Метка не читается вслух.")
+	return b.String()
+}
+
+var emotionTagRe = regexp.MustCompile(`^\s*\[(радость|грусть|удивление|злость|нежность|спокойно|нейтрально)\]\s*`)
+
+// takeEmotion strips the mood tag from the answer and remembers it.
+func takeEmotion(ctx context.Context, answer string) string {
+	m := emotionTagRe.FindStringSubmatch(answer)
+	if m == nil {
+		// a tag somewhere else must never be read aloud
+		return strings.TrimSpace(emotionAnywhereRe.ReplaceAllString(answer, ""))
+	}
+	e := map[string]string{"радость": "joy", "грусть": "sad", "удивление": "wow", "злость": "angry", "нежность": "love"}[m[1]]
+	if e == "" {
+		e = "neutral"
+	}
+	voiceFrom(ctx).setEmotion(e)
+	writeEmotionFile(e)
+	return strings.TrimSpace(emotionAnywhereRe.ReplaceAllString(answer[len(m[0]):], ""))
+}
+
+var emotionAnywhereRe = regexp.MustCompile(`\[(?:радость|грусть|удивление|злость|нежность|спокойно|нейтрально)\]\s*`)
+
+func writeEmotionFile(e string) {
+	path := envPath("QUASAR_EMOTION_FILE", "/var/run/alice-emotion")
+	if path == "-" {
+		return
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, []byte(e+"\n"), 0o644); err == nil {
+		_ = os.Rename(tmp, path)
+	}
+}
+
+// ttsStyle fills TtsGenerate options for this request. Markup is the one the
+// stock cloud uses itself (seen in native_cloud_voice_markup):
+//
+//	whisper: <speaker is_whisper="true">
+//	emotion: <speaker voice="emotional_alice.gpu" emotion="calm_happy">
+func ttsStyle(ctx context.Context, text string) (string, *float64, *string) {
+	v := voiceFrom(ctx)
+	var volume *float64
+	prefix := ""
+	if v.isWhisper("tts") {
+		w := os.Getenv("QUASAR_WHISPER_TTS_PREFIX")
+		if w == "" {
+			w = `<speaker is_whisper="true">`
+		}
+		if w != "-" {
+			prefix += w
+		}
+		if vol := envFloat("QUASAR_WHISPER_TTS_VOLUME", 0.5); vol > 0 {
+			volume = &vol
+		}
+	}
+	if envOn("QUASAR_TTS_EMOTION", true) {
+		if e := ttsEmotion(v.getEmotion()); e != "" {
+			voice := os.Getenv("QUASAR_TTS_EMOTION_VOICE")
+			if voice == "" {
+				voice = "emotional_alice.gpu"
+			}
+			prefix += `<speaker voice="` + voice + `" emotion="` + e + `">`
+		}
+	}
+	return prefix + text, volume, nil
+}
+
+// ttsEmotion maps our mood to the synthesis emotion; others are set via QUASAR_TTS_EMOTION_MAP,
+// e.g. "joy=calm_happy,love=calm_happy,sad=sad".
+func ttsEmotion(mood string) string {
+	// accepted by Yandex TTS for emotional_alice.gpu (sweep 2026-11-10):
+	// calm_happy, sad, neutral, energetic; others time out.
+	m := map[string]string{"joy": "calm_happy", "love": "calm_happy", "wow": "energetic", "sad": "sad", "angry": "energetic"}
+	if spec := os.Getenv("QUASAR_TTS_EMOTION_MAP"); spec != "" {
+		m = map[string]string{}
+		for _, kv := range strings.Split(spec, ",") {
+			if k, val, ok := strings.Cut(strings.TrimSpace(kv), "="); ok && regexp.MustCompile(`^[a-z_]{1,32}$`).MatchString(val) {
+				m[k] = val
+			}
+		}
+	}
+	return m[mood]
+}
+
+// cloudSmile is the stock clock-screen animation the cloud sends with
+// «ты молодец» / «я тебя люблю» on the Station Midi (19 frames, gzip).
+const cloudSmile = "H4sIAAAAAAAAA52SQQqAQAhFjVZBSw/koTqAN/NS7aeGxkD6Qo6LEXmP4SMSlYpHl1wJyH3N/YDct9wPyP2W+wExidxNoA8Qk/Z8Cn2AmKznM+gDxNT63KD/ReueqI//Pl7bUf6/mr+6n+r+R1TkAzR7P5r7Ac3e/89azgtrDSgqkAMAAA=="
+
+// emotionAnimation returns the gzip+base64 clock animation for a mood:
+// a custom file /data/opt/quasar-bridge/emotions/<mood>.scled (raw frames:
+// 46 segment bytes + 2 bytes duration each, as in the cloud animation) wins,
+// then our built-in pictures, joy uses the stock smile.
+func emotionAnimation(mood string) string {
+	dir := envPath("QUASAR_EMOTIONS_DIR", "/data/opt/quasar-bridge/emotions")
+	if raw, err := os.ReadFile(dir + "/" + mood + ".scled"); err == nil && len(raw) > 0 && len(raw) < 1<<16 {
+		var buf bytes.Buffer
+		zw := gzip.NewWriter(&buf)
+		_, _ = zw.Write(raw)
+		_ = zw.Close()
+		return base64.StdEncoding.EncodeToString(buf.Bytes())
+	}
+	if a, ok := clockEmotions[mood]; ok {
+		return a
+	}
+	if mood == "joy" {
+		return cloudSmile
+	}
+	return ""
+}
+
+// clockEmotions are our own clock pictures (quasar-bridge/clock-emotions/gen.py,
+// segment map measured on the Midi): sad = flat eyes, frown and a tear;
+// angry = slanted brows; wow = wide eyes and an O mouth; love = ^ ^ and a
+// heartbeat on the colon.
+var clockEmotions = map[string]string{
+	"sad":   "H4sIAAAAAAAC/2NgAAMHMIIQDg4MyACFJwKlG8AIQjQ0oKhvwKZ+PxhBiP37UdTvx6b+PxhBiP//UdT/p0A9UwRMDXHqGVkQhhOvnkTzB5t7SA1PcuKX1PRDavokEjB+AQBgZQXLAAMAAA==",
+	"angry": "H4sIAAAAAAAC/2NgcGAAAjABJZEZQCYSm4FBhIGhAUSDCSiJzAAyG9DU7wfRYAJKIjOAzP1o6v+DaDABJZEZQOZ/CtQzfiHR/AUoCrCpR2EzVIws80HhSWr8kpp+SE2fpADGLwCy72NMAAMAAA==",
+	"wow":   "H4sIAAAAAAAC/52QwQ1AIQhD68k/gAM5mpu51L8rxSZ4RdL0WeGAoncANErBcW6hs6phDAONUnAgWvf8nAYapeBAtO75tQw0SsGBaD3P1y+9T/a92f9MVfk3dvPEjbABAAA=",
+	"love":  "H4sIAAAAAAAC/2NwcGDABRzgBByIMDQ04FTfACeQ1O/fj1P9fjiBpP7/f5zq/8MJctUz6hCnHq6oh0T35NHWfMYlo+4fYPeTmp5JzS+k5keSAOMXAO35bHHwAwAA",
+}
+
+// emotionDirective draws the emotion on the clock screen the way the cloud does.
+func emotionDirective(ctx context.Context) *directives.TDirective {
+	if !envOn("QUASAR_EMOTION_ANIMATION", true) {
+		return nil
+	}
+	anim := emotionAnimation(voiceFrom(ctx).getEmotion())
+	if anim == "" {
+		return nil
+	}
+	payload, err := proto.Marshal(&animation.TAnimationCapability_TDrawAnimationDirective{
+		AnimationStopPolicy: animation.TAnimationCapability_TDrawAnimationDirective_PlayOnce,
+		Animations: []*animation.TAnimationCapability_TDrawAnimationDirective_TAnimation{{
+			Value: &animation.TAnimationCapability_TDrawAnimationDirective_TAnimation_BinaryAnimation{
+				BinaryAnimation: &animation.TAnimationCapability_TDrawAnimationDirective_TAnimation_TBinaryAnimation{
+					Compression:        animation.TAnimationCapability_TDrawAnimationDirective_TAnimation_TBinaryAnimation_Gzip,
+					Base64EncodedValue: anim,
+				},
+			},
+		}},
+	})
+	if err != nil {
+		return nil
+	}
+	return &directives.TDirective{Type: "client_action", Name: "draw_animation_directive", AnalyticsType: "draw_animation_directive", IsLedSilent: true, PayloadType: &directives.TDirective_PayloadRaw{PayloadRaw: payload}}
+}
+
+// emotionFirst orders the reply like the cloud does: the clock picture first,
+// then the speech placeholder, so the clock plays while Alice talks instead
+// of after the phrase.
+func emotionFirst(d *directives.TDirective, rest []*directives.TDirective) []*directives.TDirective {
+	if len(rest) == 0 {
+		rest = []*directives.TDirective{{Type: "client_action", Name: "tts_play_placeholder"}}
+	}
+	return append([]*directives.TDirective{d}, rest...)
+}
+
+// ---- no obscene language ----
+
+const matPrefixes = `(?:по|на|за|от|ото|раз|рас|разъ|вы|до|у|при|об|объ|о|пере|под|подъ|въ|съ|недо|ни)?`
+
+var matWordRes = []*regexp.Regexp{
+	regexp.MustCompile(`^` + matPrefixes + `х[уy](?:й|е|ё|я|ю|и)`),
+	regexp.MustCompile(`пизд`),
+	regexp.MustCompile(`^` + matPrefixes + `[её]б(?:а|у|л|н|ё|е|и|ы|т|к|ищ|ну)`),
+	regexp.MustCompile(`^` + matPrefixes + `бля(?:д|т|$)`),
+	regexp.MustCompile(`^` + matPrefixes + `муд(?:ак|ач|ил|оз|охл)`),
+	regexp.MustCompile(`пид[оа]р`),
+	regexp.MustCompile(`долбо[её]б`),
+	regexp.MustCompile(`^залуп`),
+	regexp.MustCompile(`^` + matPrefixes + `дроч`),
+	regexp.MustCompile(`^манд(?:а|ы|е|у|ой|ёнок)$`),
+}
+var wordRe = regexp.MustCompile(`[\p{L}]+`)
+
+// hasMat reports whether text contains Russian obscene words.
+func hasMat(text string) bool {
+	for _, w := range wordRe.FindAllString(strings.ToLower(text), -1) {
+		if matWord(w) {
+			return true
+		}
+	}
+	return false
+}
+func matWord(w string) bool {
+	for _, re := range matWordRes {
+		if re.MatchString(w) {
+			return true
+		}
+	}
+	return false
+}
+
+// stripMat removes obscene words as the last resort.
+func stripMat(text string) string {
+	out := wordRe.ReplaceAllStringFunc(text, func(w string) string {
+		if matWord(strings.ToLower(w)) {
+			return ""
+		}
+		return w
+	})
+	out = regexp.MustCompile(`\s+([,.!?])`).ReplaceAllString(out, "$1")
+	out = regexp.MustCompile(`,(?:\s*,)+`).ReplaceAllString(out, ",")
+	out = regexp.MustCompile(`,\s*([.!?])`).ReplaceAllString(out, "$1")
+	out = regexp.MustCompile(`\s{2,}`).ReplaceAllString(out, " ")
+	return strings.TrimSpace(out)
+}
+
+const rewriteNoMat = "Перепиши ответ голосовой колонки без нецензурной лексики и без грубых ругательств. Сохрани смысл, иронию и остроумие, ответ должен остаться колким, но приличным. Верни только новый текст ответа, без пояснений и без кавычек."
+
+var markupRe = regexp.MustCompile(`<[^<>]{1,120}>`)
+
+// cloudMarkup lists the distinct markup tags of a cloud voice text.
+func cloudMarkup(text string) string {
+	seen := map[string]bool{}
+	var out []string
+	for _, t := range markupRe.FindAllString(text, 20) {
+		if !seen[t] {
+			seen[t] = true
+			out = append(out, t)
+		}
+	}
+	return strings.Join(out, " ")
+}
+
+// matchedUser applies the on-device voice biometry result that aliced sends
+// as a MatchedUser event after the phrase (the VoiceInput itself has none).
+func (v *voiceInfo) matchedUser(mu *request.TAliceRequestProto) {
+	if v == nil || mu == nil {
+		return
+	}
+	add := mu.GetRequest().GetAdditionalOptions()
+	g := add.GetGuestUserOptions()
+	users := []string{}
+	for _, u := range add.GetUsersOptions() {
+		if u.GetPersId() != "" {
+			users = append(users, shortHash(u.GetPersId()))
+		} else if u.GetPuid() != "" {
+			users = append(users, "puid:"+shortHash(u.GetPuid()))
+		}
+	}
+	enrolled := []string{}
+	for _, h := range mu.GetEnrollmentHeaders().GetHeaders() {
+		enrolled = append(enrolled, h.GetUserType().String()+":"+shortHash(h.GetPersonId()))
+	}
+	for _, h := range g.GetEnrollmentHeaders().GetHeaders() {
+		enrolled = append(enrolled, "g"+h.GetUserType().String()+":"+shortHash(h.GetPersonId()))
+	}
+	speaker := ""
+	if g.GetStatus().String() == "Match" && g.GetPersId() != "" {
+		speaker = "pers:" + shortHash(g.GetPersId())
+	}
+	v.mu.Lock()
+	if speaker != "" {
+		v.speaker = speaker
+	}
+	v.mu.Unlock()
+	slog.Info("native_matched_user", "request", v.id, "guest", g != nil, "guest_origin", g.GetGuestOrigin().String(),
+		"guest_status", g.GetStatus().String(), "guest_confidence", g.GetMatchConfidence().String(),
+		"confidence10", g.GetConfidenceLevel10(), "owner_enrolled", g.GetIsOwnerEnrolled(),
+		"guest_pers", func() string {
+			if g.GetPersId() == "" {
+				return ""
+			}
+			return shortHash(g.GetPersId())
+		}(), "users", strings.Join(users, ","), "enrolled", strings.Join(enrolled, ","), "speaker", speaker)
+}
+
+// logCloudDirectives records how the stock cloud draws emotions on the clock:
+// animation directives in full (they carry no user data).
+func logCloudDirectives(ds []*directives.TDirective) {
+	for _, d := range ds {
+		if !strings.Contains(d.GetName(), "animation") && !strings.Contains(d.GetName(), "emotion") {
+			continue
+		}
+		body := ""
+		if raw := d.GetPayloadRaw(); len(raw) > 0 {
+			var m animation.TAnimationCapability_TDrawAnimationDirective
+			if err := proto.Unmarshal(raw, &m); err == nil {
+				body = protojson.Format(&m)
+			} else {
+				body = fmt.Sprintf("raw:%x", raw)
+			}
+		} else if pl := d.GetPayload(); pl != nil {
+			body = protojson.Format(pl)
+		}
+		if len(body) > 6000 {
+			body = body[:6000]
+		}
+		slog.Info("native_cloud_animation", "name", d.GetName(), "type", d.GetType(), "directive_type", d.GetDirectiveType().String(), "led_silent", d.GetIsLedSilent(), "payload", body)
+	}
+}
