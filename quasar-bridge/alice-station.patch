new file mode 100644
index 0000000..388b396
--- /dev/null
+++ b/internal/bridge/silk.go
@@ -0,0 +1,568 @@
+package bridge
+
+// Whisper detection from the microphone stream without decoding audio
+// (Alice Station patch).
+//
+// The Station uploads the request audio as Opus. In SILK and Hybrid modes
+// every SILK frame starts with a range-coded frame type (inactive, unvoiced,
+// voiced) and the first gain index (RFC 6716, 4.2.7.3-4.2.7.4). Whispered
+// speech has no vocal-fold vibration, so the encoder marks active frames as
+// unvoiced; normal speech is mostly voiced. Only a few symbols per packet are
+// read, so this costs next to nothing on the speaker CPU.
+
+import (
+	"encoding/binary"
+	"sort"
+)
+
+// silkStats summarizes one utterance.
+type silkStats struct {
+	Packets  int // Opus packets seen
+	CELT     int // packets without SILK layer (no voicing information)
+	Inactive int // SILK frames without voice activity
+	Unvoiced int // active unvoiced frames
+	Voiced   int // active voiced frames
+	GainSum  int // sum of first gain indices (0..63) of active frames
+	Skipped  int // packets we could not parse (stereo, code 3, too short)
+	// CELT-only packets: the pitch pre/post-filter is switched on for
+	// periodic (voiced) sound and stays off for noise-like sound (whisper).
+	CELTSilent  int
+	CELTPitched int
+	CELTFlat    int
+	CELTGainSum int // sum of post-filter gain steps (1..8) of pitched frames
+	// Coarse band energies (log2) predicted across frames, and per-frame
+	// level and spectral tilt: voiced speech has strong harmonics below
+	// 600 Hz, whisper is breath noise with almost nothing there.
+	celtE    [21]float64
+	Frames   []celtFrame
+	celtFail int
+}
+
+type celtFrame struct{ Level, Tilt float64 }
+
+// PitchedRatio is the share of non-silent CELT frames with the pitch filter on.
+func (s silkStats) PitchedRatio() float64 {
+	n := s.CELTPitched + s.CELTFlat
+	if n == 0 {
+		return 1
+	}
+	return float64(s.CELTPitched) / float64(n)
+}
+
+func (s silkStats) Active() int { return s.Voiced + s.Unvoiced }
+
+// VoicedRatio is the share of voiced frames among active ones.
+func (s silkStats) VoicedRatio() float64 {
+	if s.Active() == 0 {
+		return 1
+	}
+	return float64(s.Voiced) / float64(s.Active())
+}
+
+// MeanGain is the average SILK gain index of active frames (~1.4 dB per step).
+func (s silkStats) MeanGain() float64 {
+	if s.Active() == 0 {
+		return 0
+	}
+	return float64(s.GainSum) / float64(s.Active())
+}
+
+// rangeDec is the minimal Opus range decoder (RFC 6716, 4.1).
+type rangeDec struct {
+	buf      []byte
+	pos      int
+	rng, val uint32
+	rem      uint32
+	ext      uint32
+	endOffs  int
+	endWin   uint32
+	endBits  int
+	nbits    int
+}
+
+func ilog(x uint32) int {
+	n := 0
+	for x != 0 {
+		n++
+		x >>= 1
+	}
+	return n
+}
+func (d *rangeDec) tell() int { return d.nbits - ilog(d.rng) }
+func (d *rangeDec) decode(ft uint32) uint32 {
+	d.ext = d.rng / ft
+	s := d.val / d.ext
+	return ft - min(s+1, ft)
+}
+func (d *rangeDec) update(fl, fh, ft uint32) {
+	s := d.ext * (ft - fh)
+	d.val -= s
+	if fl > 0 {
+		d.rng = d.ext * (fh - fl)
+	} else {
+		d.rng -= s
+	}
+	d.normalize()
+}
+
+// uintSmall decodes ec_dec_uint for ft <= 256.
+func (d *rangeDec) uintSmall(ft uint32) uint32 {
+	s := d.decode(ft)
+	d.update(s, s+1, ft)
+	return s
+}
+func (d *rangeDec) bits(n int) uint32 {
+	w := d.endWin
+	avail := d.endBits
+	if avail < n {
+		for avail <= 32-8 {
+			var b uint32
+			if d.endOffs < len(d.buf) {
+				d.endOffs++
+				b = uint32(d.buf[len(d.buf)-d.endOffs])
+			}
+			w |= b << avail
+			avail += 8
+		}
+	}
+	ret := w & (1<<n - 1)
+	d.endWin = w >> n
+	d.endBits = avail - n
+	d.nbits += n
+	return ret
+}
+
+func (d *rangeDec) byte() uint32 {
+	if d.pos < len(d.buf) {
+		b := d.buf[d.pos]
+		d.pos++
+		return uint32(b)
+	}
+	return 0
+}
+func newRangeDec(buf []byte) *rangeDec {
+	d := &rangeDec{buf: buf, rng: 128, nbits: 9}
+	d.rem = d.byte()
+	d.val = d.rng - 1 - (d.rem >> 1)
+	d.normalize()
+	return d
+}
+func (d *rangeDec) normalize() {
+	for d.rng <= 1<<23 {
+		d.nbits += 8
+		d.rng <<= 8
+		sym := d.rem
+		d.rem = d.byte()
+		sym = (sym<<8 | d.rem) >> 1
+		d.val = ((d.val << 8) + (255 &^ sym)) & (1<<31 - 1)
+	}
+}
+func (d *rangeDec) bitLogp(logp uint) bool {
+	r := d.rng
+	v := d.val
+	s := r >> logp
+	ret := v < s
+	if !ret {
+		d.val = v - s
+		d.rng = r - s
+	} else {
+		d.rng = s
+	}
+	d.normalize()
+	return ret
+}
+func (d *rangeDec) icdf(table []uint8, ftb uint) int {
+	s := d.rng
+	v := d.val
+	r := s >> ftb
+	ret := -1
+	var t uint32
+	for {
+		t = s
+		ret++
+		s = r * uint32(table[ret])
+		if v >= s {
+			break
+		}
+	}
+	d.val = v - s
+	d.rng = t - s
+	d.normalize()
+	return ret
+}
+
+// Tables from libopus silk/tables_other.c and silk/tables_gain.c.
+var (
+	silkTypeOffsetVAD   = []uint8{232, 158, 10, 0}
+	silkTypeOffsetNoVAD = []uint8{230, 0}
+	silkLBRRFlags2      = []uint8{203, 150, 0}
+	silkLBRRFlags3      = []uint8{215, 195, 166, 125, 110, 82, 0}
+	silkUniform8        = []uint8{224, 192, 160, 128, 96, 64, 32, 0}
+	silkGain            = [3][]uint8{
+		{224, 112, 44, 15, 3, 2, 1, 0},
+		{254, 237, 192, 132, 70, 23, 4, 0},
+		{255, 252, 226, 155, 61, 11, 2, 0},
+	}
+)
+
+// addOpusPacket inspects the first SILK frame of one Opus packet.
+func (s *silkStats) addOpusPacket(p []byte) {
+	if len(p) < 2 {
+		s.Skipped++
+		return
+	}
+	s.Packets++
+	toc := p[0]
+	config := int(toc >> 3)
+	if config >= 16 {
+		s.CELT++
+		s.addCELT(p)
+		return
+	}
+	if toc&0x04 != 0 { // stereo: the stereo predictor comes first, skip
+		s.Skipped++
+		return
+	}
+	var ms int
+	if config < 12 {
+		ms = []int{10, 20, 40, 60}[config%4]
+	} else {
+		ms = []int{10, 20}[config%2]
+	}
+	frame := p[1:]
+	switch toc & 3 {
+	case 2:
+		if len(frame) < 1 {
+			s.Skipped++
+			return
+		}
+		if frame[0] >= 252 {
+			if len(frame) < 2 {
+				s.Skipped++
+				return
+			}
+			frame = frame[2:]
+		} else {
+			frame = frame[1:]
+		}
+	case 3:
+		s.Skipped++
+		return
+	}
+	if len(frame) < 2 {
+		s.Skipped++
+		return
+	}
+	nFrames := 1
+	if ms == 40 {
+		nFrames = 2
+	} else if ms == 60 {
+		nFrames = 3
+	}
+	d := newRangeDec(frame)
+	vad := make([]bool, nFrames)
+	for i := range vad {
+		vad[i] = d.bitLogp(1)
+	}
+	lbrr := d.bitLogp(1)
+	lbrrFirst := false
+	if lbrr {
+		if nFrames == 1 {
+			lbrrFirst = true
+		} else {
+			table := silkLBRRFlags2
+			if nFrames == 3 {
+				table = silkLBRRFlags3
+			}
+			sym := d.icdf(table, 8) + 1
+			lbrrFirst = sym != 0 // LBRR frames precede the regular ones
+		}
+	}
+	active := lbrrFirst || vad[0]
+	var signal int
+	if active {
+		signal = (d.icdf(silkTypeOffsetVAD, 8) + 2) >> 1
+	} else {
+		signal = d.icdf(silkTypeOffsetNoVAD, 8) >> 1
+	}
+	if signal == 0 {
+		s.Inactive++
+		return
+	}
+	gain := d.icdf(silkGain[signal], 8)<<3 + d.icdf(silkUniform8, 8)
+	s.GainSum += gain
+	if signal == 2 {
+		s.Voiced++
+	} else {
+		s.Unvoiced++
+	}
+}
+
+// micTap collects Opus packets from the uploaded microphone stream. The
+// payload is either raw Opus packets (one per message) or an Ogg stream.
+type micTap struct {
+	ogg     []byte
+	partial []byte
+	isOgg   int // 0 unknown, 1 ogg, 2 raw
+	stats   silkStats
+}
+
+func (m *micTap) feed(b []byte) {
+	if m.isOgg == 0 {
+		if len(b) >= 4 && string(b[:4]) == "OggS" {
+			m.isOgg = 1
+		} else {
+			m.isOgg = 2
+		}
+	}
+	if m.isOgg == 2 {
+		m.stats.addOpusPacket(b)
+		return
+	}
+	if len(m.ogg)+len(b) > 1<<20 {
+		m.ogg = nil
+		return
+	}
+	m.ogg = append(m.ogg, b...)
+	for len(m.ogg) >= 27 {
+		p := m.ogg
+		if string(p[:4]) != "OggS" {
+			m.ogg = nil
+			return
+		}
+		count := int(p[26])
+		if len(p) < 27+count {
+			return
+		}
+		size := 27 + count
+		for _, n := range p[27 : 27+count] {
+			size += int(n)
+		}
+		if len(p) < size {
+			return
+		}
+		body := p[27+count : size]
+		for _, n := range p[27 : 27+count] {
+			m.partial = append(m.partial, body[:n]...)
+			body = body[n:]
+			if n < 255 {
+				pkt := m.partial
+				m.partial = nil
+				if len(pkt) >= 8 && (string(pkt[:8]) == "OpusHead" || string(pkt[:8]) == "OpusTags") {
+					continue
+				}
+				m.stats.addOpusPacket(pkt)
+			}
+		}
+		m.ogg = p[size:]
+	}
+}
+
+// streamID reads the 4-byte stream prefix of a binary uniproxy frame.
+func streamID(data []byte) (uint32, bool) {
+	if len(data) < 4 {
+		return 0, false
+	}
+	return binary.BigEndian.Uint32(data), true
+}
+
+// firstFrame returns the exact bytes of the first frame (RFC 6716, 3.2).
+func firstFrame(p []byte) []byte {
+	if len(p) < 2 {
+		return nil
+	}
+	rest := p[1:]
+	switch p[0] & 3 {
+	case 0:
+		return rest
+	case 1:
+		if len(rest)%2 != 0 {
+			return nil
+		}
+		return rest[:len(rest)/2]
+	case 2:
+		n := int(rest[0])
+		hdr := 1
+		if n >= 252 {
+			if len(rest) < 2 {
+				return nil
+			}
+			n += 4 * int(rest[1])
+			hdr = 2
+		}
+		if len(rest) < hdr+n {
+			return nil
+		}
+		return rest[hdr : hdr+n]
+	default:
+		m := int(rest[0] & 0x3f)
+		if m == 0 || rest[0]&0xc0 != 0 { // VBR or padding: not needed for the Station stream
+			return nil
+		}
+		body := rest[1:]
+		if len(body)%m != 0 {
+			return nil
+		}
+		return body[:len(body)/m]
+	}
+}
+
+// addCELT reads the silence flag and the pitch post-filter flag of the
+// first CELT frame (RFC 6716, 4.3 and libopus celt_decode_with_ec).
+func (s *silkStats) addCELT(p []byte) {
+	f := firstFrame(p)
+	if len(f) < 3 {
+		s.Skipped++
+		return
+	}
+	if p[0]&0x04 != 0 { // stereo is fine: the post-filter comes before channel data
+	}
+	total := len(f) * 8
+	d := newRangeDec(f)
+	if d.tell() >= total || (d.tell() == 1 && d.bitLogp(15)) {
+		s.CELTSilent++
+		return
+	}
+	if d.tell()+16 > total {
+		s.Skipped++
+		return
+	}
+	if d.bitLogp(1) {
+		octave := d.uintSmall(6)
+		_ = d.bits(int(4 + octave))
+		qg := d.bits(3)
+		if d.tell()+2 <= total {
+			d.icdf([]uint8{2, 1, 0}, 2)
+		}
+		s.CELTPitched++
+		s.CELTGainSum += int(qg) + 1
+	} else {
+		s.CELTFlat++
+	}
+	if p[0]&0x04 != 0 {
+		return // stereo energies interleave channels; the Station mic is mono
+	}
+	config := int(p[0] >> 3)
+	lm := config % 4 // 2.5, 5, 10, 20 ms
+	end := []int{13, 17, 19, 21}[(config-16)/4]
+	if lm > 0 && d.tell()+3 <= total {
+		d.bitLogp(3) // transient
+	}
+	intra := false
+	if d.tell()+3 <= total {
+		intra = d.bitLogp(3)
+	}
+	s.coarseEnergy(d, total, lm, end, intra)
+}
+
+var (
+	celtPredCoef = [4]float64{29440 / 32768., 26112 / 32768., 21248 / 32768., 16384 / 32768.}
+	celtBetaCoef = [4]float64{30147 / 32768., 22282 / 32768., 12124 / 32768., 6554 / 32768.}
+	celtEMeans   = [21]float64{6.4375, 6.25, 5.75, 5.3125, 5.0625, 4.8125, 4.5, 4.375, 4.875, 4.6875,
+		4.5625, 4.4375, 4.875, 4.625, 4.3125, 4.5, 4.375, 4.625, 4.75, 4.4375, 3.75}
+	// e_prob_model from libopus celt/quant_bands.c: [LM][intra][2*band]
+	celtProbModel = [4][2][42]uint8{
+		{{72, 127, 65, 129, 66, 128, 65, 128, 64, 128, 62, 128, 64, 128, 64, 128, 92, 78, 92, 79, 92, 78, 90, 79, 116, 41, 115, 40, 114, 40, 132, 26, 132, 26, 145, 17, 161, 12, 176, 10, 177, 11},
+			{24, 179, 48, 138, 54, 135, 54, 132, 53, 134, 56, 133, 55, 132, 55, 132, 61, 114, 70, 96, 74, 88, 75, 88, 87, 74, 89, 66, 91, 67, 100, 59, 108, 50, 120, 40, 122, 37, 97, 43, 78, 50}},
+		{{83, 78, 84, 81, 88, 75, 86, 74, 87, 71, 90, 73, 93, 74, 93, 74, 109, 40, 114, 36, 117, 34, 117, 34, 143, 17, 145, 18, 146, 19, 162, 12, 165, 10, 178, 7, 189, 6, 190, 8, 177, 9},
+			{23, 178, 54, 115, 63, 102, 66, 98, 69, 99, 74, 89, 71, 91, 73, 91, 78, 89, 86, 80, 92, 66, 93, 64, 102, 59, 103, 60, 104, 60, 117, 52, 123, 44, 138, 35, 133, 31, 97, 38, 77, 45}},
+		{{61, 90, 93, 60, 105, 42, 107, 41, 110, 45, 116, 38, 113, 38, 112, 38, 124, 26, 132, 27, 136, 19, 140, 20, 155, 14, 159, 16, 158, 18, 170, 13, 177, 10, 187, 8, 192, 6, 175, 9, 159, 10},
+			{21, 178, 59, 110, 71, 86, 75, 85, 84, 83, 91, 66, 88, 73, 87, 72, 92, 75, 98, 72, 105, 58, 107, 54, 115, 52, 114, 55, 112, 56, 129, 51, 132, 40, 150, 33, 140, 29, 98, 35, 77, 42}},
+		{{42, 121, 96, 66, 108, 43, 111, 40, 117, 44, 123, 32, 120, 36, 119, 33, 127, 33, 134, 34, 139, 21, 147, 23, 152, 20, 158, 25, 154, 26, 166, 21, 173, 16, 184, 13, 184, 10, 150, 13, 139, 15},
+			{22, 178, 63, 114, 74, 82, 84, 83, 92, 82, 103, 62, 96, 72, 96, 67, 101, 73, 107, 72, 113, 55, 118, 52, 125, 52, 118, 52, 117, 55, 135, 49, 137, 39, 157, 32, 145, 29, 97, 33, 77, 40}},
+	}
+)
+
+func (d *rangeDec) decodeBin(bits uint) uint32 {
+	d.ext = d.rng >> bits
+	s := d.val / d.ext
+	return 1<<bits - min(s+1, 1<<bits)
+}
+
+// laplace is ec_laplace_decode from libopus celt/laplace.c.
+func (d *rangeDec) laplace(fs uint32, decay uint32) int {
+	const minp = 1
+	const nmin = 16
+	val := 0
+	fm := d.decodeBin(15)
+	var fl uint32
+	if fm >= fs {
+		val++
+		fl = fs
+		fs = ((32768-minp*2*nmin-fs)*(16384-decay))>>15 + minp
+		for fs > minp && fm >= fl+2*fs {
+			fs *= 2
+			fl += fs
+			fs = ((fs - 2*minp) * decay) >> 15
+			fs += minp
+			val++
+		}
+		if fs <= minp {
+			di := (fm - fl) >> 1
+			val += int(di)
+			fl += 2 * di * minp
+		}
+		if fm < fl+fs {
+			val = -val
+		} else {
+			fl += fs
+		}
+	}
+	d.update(fl, min(fl+fs, 32768), 32768)
+	return val
+}
+
+func (s *silkStats) coarseEnergy(d *rangeDec, total, lm, end int, intra bool) {
+	coef, beta := celtPredCoef[lm], celtBetaCoef[lm]
+	model := celtProbModel[lm][0]
+	if intra {
+		coef, beta = 0, 4915/32768.
+		model = celtProbModel[lm][1]
+	}
+	prev := 0.0
+	for i := 0; i < end; i++ {
+		var qi int
+		left := total - d.tell()
+		switch {
+		case left >= 15:
+			pi := 2 * min(i, 20)
+			qi = d.laplace(uint32(model[pi])<<7, uint32(model[pi+1])<<6)
+		case left >= 2:
+			v := d.icdf([]uint8{2, 1, 0}, 2)
+			qi = (v >> 1) ^ -(v & 1)
+		case left >= 1:
+			if d.bitLogp(1) {
+				qi = -1
+			}
+		default:
+			qi = -1
+		}
+		q := float64(qi)
+		old := max(-9, s.celtE[i])
+		s.celtE[i] = coef*old + prev + q
+		prev = prev + q - beta*q
+	}
+	abs := func(i int) float64 { return s.celtE[i] + celtEMeans[i] }
+	low := (abs(0) + abs(1) + abs(2)) / 3
+	mid := (abs(8) + abs(9) + abs(10) + abs(11) + abs(12)) / 5
+	level := 0.0
+	for i := 0; i < 13; i++ {
+		level = max(level, abs(i))
+	}
+	if len(s.Frames) < 1500 {
+		s.Frames = append(s.Frames, celtFrame{Level: level, Tilt: low - mid})
+	}
+}
+
+// CELTTilt returns the median low-minus-mid band energy (log2 units, 1 = 6 dB)
+// over the loudest 30% of frames, and how many frames it used.
+func (s silkStats) CELTTilt() (float64, int) {
+	if len(s.Frames) == 0 {
+		return 0, 0
+	}
+	fs := append([]celtFrame(nil), s.Frames...)
+	sort.Slice(fs, func(i, j int) bool { return fs[i].Level > fs[j].Level })
+	fs = fs[:max(1, len(fs)*3/10)]
+	sort.Slice(fs, func(i, j int) bool { return fs[i].Tilt < fs[j].Tilt })
+	return fs[len(fs)/2].Tilt, len(fs)
+}
diff --git a/internal/bridge/voicestyle.go b/internal/bridge/voicestyle.go
new file mode 100644
index 0000000..0f675e3
--- /dev/null
+++ b/internal/bridge/voicestyle.go
@@ -0,0 +1,576 @@
+package bridge
+
+// Voice style for the LLM route (Alice Station patch): whisper, speaker
+// name by Yandex voice biometry, emotions, no obscene language.
+//
+// Environment (runtime.env), all optional:
+//   QUASAR_WHISPER=0                  disable whisper detection by sound
+//   QUASAR_WHISPER_NIGHT=23:15-06:30  night mode (Moscow): always whisper and short
+//   QUASAR_WHISPER_VOICED_MAX=0.2     voiced share of speech below which it is a whisper
+//   QUASAR_WHISPER_MIN_FRAMES=12      minimum active 20 ms frames to decide
+//   QUASAR_WHISPER_CELT_TILT_MAX=1.5  CELT: low-minus-mid energy (log2) at or below which it is a whisper
+//   QUASAR_WHISPER_TTS_PREFIX='<speaker is_whisper="true">'   TTS markup for a whispered reply ("-" = none)
+//   QUASAR_WHISPER_TTS_VOLUME=0.5     TtsGenerate.Volume for a whispered reply (0 = not set)
+//   QUASAR_TTS_EMOTION=0              no emotional voice (<speaker voice="emotional_alice.gpu" emotion=...>)
+//   QUASAR_TTS_EMOTION_MAP            mood=emotion list, default joy/love/wow=calm_happy
+//   QUASAR_EMOTION_ANIMATION=0        no clock animation (draw_animation_directive, BinaryAnimation)
+//   QUASAR_EMOTIONS_DIR               own clock animations <mood>.scled, default /data/opt/quasar-bridge/emotions
+//   QUASAR_EMOTION_FILE               default /var/run/alice-emotion ("-" = off), for the LED ring
+//   QUASAR_VOICES_FILE                default /data/opt/quasar-bridge/voices.json (voice id -> name)
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	directives "github.com/freequasar/quasar-go-genproto/proto/alice/protos/api/alicekit/directives"
+	request "github.com/freequasar/quasar-go-genproto/proto/alice/protos/api/alicekit/events/alice_request"
+	animation "github.com/freequasar/quasar-go-genproto/proto/alice/protos/endpoint/capabilities/animation"
+	"google.golang.org/protobuf/encoding/protojson"
