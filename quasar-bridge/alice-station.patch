+// nightMode: QUASAR_WHISPER_NIGHT="23:15-06:30" (Moscow time) — replies are
+// whispered and short in this window, whatever the detector says.
+func nightMode(now time.Time) bool {
+	spec := strings.TrimSpace(os.Getenv("QUASAR_WHISPER_NIGHT"))
+	from, to, ok := strings.Cut(spec, "-")
+	if !ok {
+		return false
+	}
+	parse := func(t string) (int, bool) {
+		h, m, ok := strings.Cut(strings.TrimSpace(t), ":")
+		hh, e1 := strconv.Atoi(h)
+		mm, e2 := strconv.Atoi(m)
+		if !ok || e1 != nil || e2 != nil || hh < 0 || hh > 23 || mm < 0 || mm > 59 {
+			return 0, false
+		}
+		return hh*60 + mm, true
+	}
+	a, ok1 := parse(from)
+	b, ok2 := parse(to)
+	if !ok1 || !ok2 || a == b {
+		return false
+	}
+	t := now.In(moscow())
+	cur := t.Hour()*60 + t.Minute()
+	if a < b {
+		return cur >= a && cur < b
+	}
+	return cur >= a || cur < b
+}
