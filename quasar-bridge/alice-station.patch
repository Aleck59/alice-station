+// flattenContentChunks rewrites choices[].message.content given as an array of
+// typed chunks (Mistral reasoning models: [{"type":"thinking",...},
+// {"type":"text","text":"..."}]) into a plain string of the "text" chunks.
+// Reasoning chunks are dropped: they must never be spoken.
+func flattenContentChunks(data []byte) ([]byte, error) {
+	var raw map[string]any
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return nil, err
+	}
+	choices, _ := raw["choices"].([]any)
+	for _, ch := range choices {
+		choice, _ := ch.(map[string]any)
+		msg, _ := choice["message"].(map[string]any)
+		parts, ok := msg["content"].([]any)
+		if !ok {
+			continue
+		}
+		var b strings.Builder
+		for _, p := range parts {
+			part, _ := p.(map[string]any)
+			if part["type"] == "text" {
+				if t, ok := part["text"].(string); ok {
+					b.WriteString(t)
+				}
+			}
+		}
+		msg["content"] = b.String()
+	}
+	return json.Marshal(raw)
+}
