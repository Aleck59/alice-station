+// recoverLocked handles a track that could not start (Station Midi: the
+// provider's googlevideo cache sometimes times out or answers 503, some
+// tracks are region-blocked). Retry the same track twice quietly, then skip
+// to the next one; speak the error only when several tracks in a row fail.
+func (s *Server) recoverLocked(g uint64, offset int64, attempt int, message string) {
+	unavailable := strings.Contains(message, "недоступен")
+	if !unavailable && attempt < 2 {
+		s.state.Status = "buffering"
+		s.state.Error = ""
+		log.Printf("start failed (%s), retry %d", message, attempt+1)
+		go func() {
+			time.Sleep(time.Duration(attempt+1) * 1500 * time.Millisecond)
+			s.startGuarded(offset, false, attempt+1, &g)
+		}()
+		return
+	}
+	if s.skipRun < 3 && s.state.Index+1 < len(s.state.Queue) {
+		s.skipRun++
+		s.state.Index++
+		s.state.PositionMS = 0
+		s.state.Status = "buffering"
+		s.state.Error = ""
+		log.Printf("start failed (%s), skipping to track %d", message, s.state.Index+1)
+		s.saveLocked()
+		go func() {
+			time.Sleep(300 * time.Millisecond)
+			s.startGuarded(0, false, 0, &g)
+		}()
+		return
+	}
+	s.skipRun = 0
+	s.failLocked(message)
+}
