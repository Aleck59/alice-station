-BT="S51bluetoothd S52bluealsa S53bluealsa-aplay S54default-bluez-agent"
+# Station Midi names these S40bluetoothd, S52bluealsa, S53bluealsa-aplay,
+# S54default-bluez-agent; Lite/Mini 2 use S51bluetoothd. Discover them.
+BT=$(ls /etc/init.d 2>/dev/null | grep -E '^S[0-9]+(bluetoothd|bluealsa|bluealsa-aplay|default-bluez-agent)$' | sort | tr '\n' ' ')
+BT_REV=$(echo $BT | tr ' ' '\n' | sort -r | tr '\n' ' ')
+[ -n "$BT" ] || { echo 'Bluetooth-службы не найдены' >&2; exit 1; }
 stop_bt() {
-    for service in S54default-bluez-agent S53bluealsa-aplay S52bluealsa S51bluetoothd; do
+    for service in $BT_REV; do
         /etc/init.d/$service stop
     done
 }
