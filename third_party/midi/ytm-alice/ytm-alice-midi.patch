diff --git a/source/ring.go b/source/ring.go
new file mode 100644
index 0000000..f4a38d2
--- /dev/null
+++ b/source/ring.go
@@ -0,0 +1,213 @@
+package main
+
+// Station Midi LED ring (/dev/fb0, 24 pixels) driven by ytm-alice while it
+// plays: a moving animation during playback and short gestures for voice
+// controls. Alice's own animations always win: nothing is written while a
+// dialog is active, and maind redraws the ring itself.
+
+import (
+	"context"
+	"math"
+	"os"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+const ringPixels = 24
+
+var ringLevel atomic.Uint32 // 0..1000 from the player's level events, 0 if unknown
+var ringLevelAt atomic.Int64
+
+type ringFX struct {
+	kind  string
+	start time.Time
+}
+
+func ringDevice() (string, int) {
+	if _, err := os.Stat("/dev/fb0"); err != nil {
+		return "", 0
+	}
+	raw, _ := os.ReadFile("/sys/class/graphics/fb0/virtual_size")
+	if !strings.HasPrefix(strings.TrimSpace(string(raw)), "24,") {
+		return "", 0
+	}
+	bpp := 24
+	if b, err := os.ReadFile("/sys/class/graphics/fb0/bits_per_pixel"); err == nil {
+		if n, e := strconv.Atoi(strings.TrimSpace(string(b))); e == nil && (n == 24 || n == 32) {
+			bpp = n
+		}
+	}
+	return "/dev/fb0", bpp
+}
+
+func (s *Server) ringEffect(kind string) {
+	select {
+	case s.ringFX <- kind:
+	default:
+	}
+}
+
+func hsv(h, sat, v float64) (float64, float64, float64) {
+	h = math.Mod(h, 1) * 6
+	i := math.Floor(h)
+	f := h - i
+	p, q, t := v*(1-sat), v*(1-sat*f), v*(1-sat*(1-f))
+	switch int(i) {
+	case 0:
+		return v, t, p
+	case 1:
+		return q, v, p
+	case 2:
+		return p, v, t
+	case 3:
+		return p, q, v
+	case 4:
+		return t, p, v
+	}
+	return v, p, q
+}
+
+// renderPlayback: two rotating colour comets; brightness follows the audio
+// level when the player reports it, otherwise a gentle ~120 bpm pulse.
+func renderPlayback(px *[ringPixels][3]float64, t float64) {
+	level := 0.0
+	if time.Since(time.UnixMilli(ringLevelAt.Load())) < time.Second {
+		level = float64(ringLevel.Load()) / 1000
+	} else {
+		level = 0.55 + 0.45*math.Pow(math.Abs(math.Sin(t*math.Pi*2)), 3)
+	}
+	head := math.Mod(t*6, ringPixels)
+	base := math.Mod(t*0.03, 1)
+	for i := 0; i < ringPixels; i++ {
+		v := 0.08
+		for _, h := range []float64{head, math.Mod(head+ringPixels/2, ringPixels)} {
+			d := math.Mod(h-float64(i)+ringPixels, ringPixels)
+			if d < 8 {
+				v = math.Max(v, 1-d/8)
+			}
+		}
+		r, g, b := hsv(base+float64(i)/ringPixels*0.35, 0.85, v*(0.25+0.75*level))
+		px[i] = [3]float64{r, g, b}
+	}
+}
+
+// renderFX returns false when the gesture is over.
+func renderFX(px *[ringPixels][3]float64, fx ringFX, now time.Time) bool {
+	e := now.Sub(fx.start).Seconds()
+	switch fx.kind {
+	case "next", "previous":
+		const dur = 0.45
+		if e > dur {
+			return false
+		}
+		pos := e / dur * ringPixels
+		for i := 0; i < ringPixels; i++ {
+			k := float64(i)
+			if fx.kind == "previous" {
+				k = float64(ringPixels - 1 - i)
+			}
+			d := pos - k
+			v := 0.0
+			if d >= 0 && d < 6 {
+				v = 1 - d/6
+			}
+			px[i] = [3]float64{v, v * 0.55, v * 0.15}
+		}
+	case "like":
+		const dur = 0.9
+		if e > dur {
+			return false
+		}
+		v := math.Pow(math.Sin(e/dur*2*math.Pi*2-math.Pi/2)*0.5+0.5, 2)
+		for i := range px {
+			px[i] = [3]float64{v, 0.05 * v, 0.25 * v}
+		}
+	case "pause":
+		const dur = 0.5
+		if e > dur {
+			return false
+		}
+		for i := range px {
+			px[i] = [3]float64{px[i][0] * 0.85, px[i][1] * 0.85, px[i][2] * 0.85}
+		}
+	default:
+		return false
+	}
+	return true
+}
+
+func (s *Server) ringLoop(ctx context.Context) {
+	path, bpp := ringDevice()
+	if path == "" {
+		return
+	}
+	f, err := os.OpenFile(path, os.O_WRONLY, 0)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	var px [ringPixels][3]float64
+	var cur *ringFX
+	lit := false
+	start := time.Now()
+	ticker := time.NewTicker(33 * time.Millisecond)
+	defer ticker.Stop()
+	buf := make([]byte, ringPixels*bpp/8)
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case k := <-s.ringFX:
+			cur = &ringFX{kind: k, start: time.Now()}
+			continue
+		case <-ticker.C:
+		}
+		if !s.aliceIdle.Load() {
+			// Alice is talking or listening: her animation owns the ring.
+			lit = false
+			continue
+		}
+		s.mu.Lock()
+		status := s.state.Status
+		enabled := s.settingsLocked().PlaybackLED
+		s.mu.Unlock()
+		now := time.Now()
+		active := false
+		if cur != nil {
+			if renderFX(&px, *cur, now) {
+				active = true
+			} else {
+				cur = nil
+			}
+		}
+		if !active && enabled && status == "playing" {
+			renderPlayback(&px, now.Sub(start).Seconds())
+			active = true
+		}
+		if !active {
+			if lit {
+				for i := range buf {
+					buf[i] = 0
+				}
+				f.WriteAt(buf, 0)
+				lit = false
+			}
+			continue
+		}
+		for i := 0; i < ringPixels; i++ {
+			c := [3]byte{}
+			for j := 0; j < 3; j++ {
+				c[j] = byte(math.Max(0, math.Min(1, px[i][j])) * 200)
+			}
+			if bpp == 32 {
+				buf[i*4], buf[i*4+1], buf[i*4+2], buf[i*4+3] = c[2], c[1], c[0], 0
+			} else {
+				buf[i*3], buf[i*3+1], buf[i*3+2] = c[0], c[1], c[2]
+			}
+		}
+		f.WriteAt(buf, 0)
+		lit = true
+	}
+}
